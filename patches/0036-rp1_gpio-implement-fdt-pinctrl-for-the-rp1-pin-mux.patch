+	[26] = { "sd0", "dpi", "i2s0", "mic", "i2s1", "gpio", "proc_rio", "pio", "spi5" },
+	[27] = { "sd0", "dpi", "i2s0", "mic", "i2s1", "gpio", "proc_rio", "pio", "spi1" },
+	[28] = { "sd1", "i2c4", "i2s2", "spi6", "vbus0", "gpio", "proc_rio", _, _ },
+	[29] = { "sd1", "i2c4", "i2s2", "spi6", "vbus0", "gpio", "proc_rio", _, _ },
