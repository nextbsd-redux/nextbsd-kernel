From: pkgdemon <jpm820@gmail.com>
Date: Sun, 23 Aug 2026 19:15:00 -0500
Subject: [PATCH] rp1: interrupt controller over RP1's MSI-X vectors

RP1 is an interrupt controller in its own right, and its children cannot
allocate an IRQ until it is a registered PIC -- which is why xhci does
not attach behind the DWC3 controllers today.

The mapping is 1:1 rather than demultiplexed: RP1 internal IRQ N is
MSI-X vector N. So there is no status register to consult in the
handler; the vector is the identity. Per-vector configuration lives in
BAR1 at 0x108008 + 4*N.

Claims all 61 vectors, registers an intr_irqsrc for each, becomes a PIC
on the rp1 device-tree node, and hooks a filter per vector that
dispatches its own source.

Level-triggered sources set IACK_EN so the block acknowledges on read;
edge-triggered ones must not, or the interrupt is lost. That distinction
comes from the second FDT interrupt cell, and post_filter acknowledges
only for level.

The controller is stood up before children are added, because their
resource lists are built from DT interrupts and those cannot be mapped
until this node is a registered PIC.

Register layout and the IACK_EN semantics are from OpenBSD's rpone(4),
which is ISC.
diff --git a/sys/arm/broadcom/bcm2835/rp1.c b/sys/arm/broadcom/bcm2835/rp1.c
index 24cbff5..a181910 100644
--- a/sys/arm/broadcom/bcm2835/rp1.c
+++ b/sys/arm/broadcom/bcm2835/rp1.c
@@ -42,16 +42,50 @@
 #include <dev/pci/pcireg.h>
 #include <dev/pci/pcivar.h>
 
+#include <machine/intr.h>
+
+#include "pic_if.h"
+
 #define	RP1_VENDOR	0x1de4
 #define	RP1_DEVICE	0x0001
 
+/*
+ * RP1 is its own interrupt controller, and the mapping is 1:1 rather than
+ * demultiplexed: internal IRQ N is MSI-X vector N. The per-vector config
+ * registers live in BAR1.
+ */
+#define	RP1_MSIX_VECTORS	61
+#define	MSIX_CFG(x)		(0x108008 + 4 * (x))
+#define	MSIX_CFG_SET(x)		(MSIX_CFG(x) + 0x800)
+#define	MSIX_CFG_CLR(x)		(MSIX_CFG(x) + 0xc00)
+#define	 MSIX_CFG_ENABLE	(1 << 0)
+#define	 MSIX_CFG_IACK		(1 << 2)
+#define	 MSIX_CFG_IACK_EN	(1 << 3)
+
+/* FDT interrupt cell 1: 4 is level-triggered, per the GIC binding. */
+#define	RP1_INTR_LEVEL		4
+
+struct rp1_irqsrc {
+	struct intr_irqsrc	isrc;
+	u_int			vec;
+	bool			level;
+};
+
 struct rp1_softc {
 	struct simplebus_softc	base;	/* must be first */
 	device_t		dev;
 	struct resource		*bar;
 	int			bar_rid;
+
+	int			nvec;
+	struct resource		**irq_res;
+	void			**cookie;
+	struct rp1_irqsrc	*isrcs;
 };
 
+#define	RP1_WR4(sc, r, v)	bus_write_4((sc)->bar, (r), (v))
+#define	RP1_RD4(sc, r)		bus_read_4((sc)->bar, (r))
+
 /*
  * Walk up to the PCI host bridge's OFW node and find the rp1 child. The node
  * is not reachable through ofw_bus_get_node() on this device, because it
@@ -84,6 +118,177 @@ rp1_find_node(device_t dev)
 	return (-1);
 }
 
+/*
+ * One handler per vector; each simply hands the interrupt to its own source.
+ * There is no status register to consult -- the vector is the identity.
+ */
+static int
+rp1_intr(void *arg)
+{
+	struct rp1_irqsrc *ri = arg;
+	struct trapframe *tf = curthread->td_intr_frame;
+
+	if (intr_isrc_dispatch(&ri->isrc, tf) != 0)
+		return (FILTER_STRAY);
+
+	return (FILTER_HANDLED);
+}
+
+static int
+rp1_map_intr(device_t dev, struct intr_map_data *data,
+    struct intr_irqsrc **isrcp)
+{
+	struct intr_map_data_fdt *fdt;
+	struct rp1_softc *sc;
+	u_int vec;
+
+	if (data->type != INTR_MAP_DATA_FDT)
+		return (ENOTSUP);
+
+	sc = device_get_softc(dev);
+	fdt = (struct intr_map_data_fdt *)data;
+	if (fdt->ncells < 1)
+		return (EINVAL);
+
+	vec = fdt->cells[0];
+	if (vec >= (u_int)sc->nvec)
+		return (EINVAL);
+
+	sc->isrcs[vec].level = (fdt->ncells > 1 &&
+	    fdt->cells[1] == RP1_INTR_LEVEL);
+	*isrcp = &sc->isrcs[vec].isrc;
+
+	return (0);
+}
+
+static void
+rp1_enable_intr(device_t dev, struct intr_irqsrc *isrc)
+{
+	struct rp1_softc *sc = device_get_softc(dev);
+	struct rp1_irqsrc *ri = (struct rp1_irqsrc *)isrc;
+
+	/*
+	 * Level-triggered sources need the block to acknowledge on read;
+	 * edge-triggered ones must not, or the interrupt is lost.
+	 */
+	if (ri->level)
+		RP1_WR4(sc, MSIX_CFG_SET(ri->vec), MSIX_CFG_IACK_EN);
+	else
+		RP1_WR4(sc, MSIX_CFG_CLR(ri->vec), MSIX_CFG_IACK_EN);
+
+	RP1_WR4(sc, MSIX_CFG_SET(ri->vec), MSIX_CFG_ENABLE);
+}
+
+static void
+rp1_disable_intr(device_t dev, struct intr_irqsrc *isrc)
+{
+	struct rp1_softc *sc = device_get_softc(dev);
+	struct rp1_irqsrc *ri = (struct rp1_irqsrc *)isrc;
+
+	RP1_WR4(sc, MSIX_CFG_CLR(ri->vec), MSIX_CFG_ENABLE);
+}
+
+static void
+rp1_pre_ithread(device_t dev, struct intr_irqsrc *isrc)
+{
+
+	rp1_disable_intr(dev, isrc);
+}
+
+static void
+rp1_post_ithread(device_t dev, struct intr_irqsrc *isrc)
+{
+
+	rp1_enable_intr(dev, isrc);
+}
+
+static void
+rp1_post_filter(device_t dev, struct intr_irqsrc *isrc)
+{
+	struct rp1_softc *sc = device_get_softc(dev);
+	struct rp1_irqsrc *ri = (struct rp1_irqsrc *)isrc;
+
+	if (ri->level)
+		RP1_WR4(sc, MSIX_CFG_SET(ri->vec), MSIX_CFG_IACK);
+}
+
+/*
+ * Claim all the MSI-X vectors and stand up an interrupt controller over them.
+ */
+static int
+rp1_setup_intr_controller(device_t dev, phandle_t node)
+{
+	struct rp1_softc *sc;
+	const char *name;
+	intptr_t xref;
+	int error, i, rid;
+
+	sc = device_get_softc(dev);
+
+	sc->nvec = pci_msix_count(dev);
+	if (sc->nvec > RP1_MSIX_VECTORS)
+		sc->nvec = RP1_MSIX_VECTORS;
+	if (sc->nvec <= 0) {
+		device_printf(dev, "no MSI-X vectors available\n");
+		return (ENXIO);
+	}
+	if (pci_alloc_msix(dev, &sc->nvec) != 0 || sc->nvec <= 0) {
+		device_printf(dev, "could not allocate MSI-X vectors\n");
+		return (ENXIO);
+	}
+
+	sc->irq_res = malloc(sizeof(*sc->irq_res) * sc->nvec, M_DEVBUF,
+	    M_WAITOK | M_ZERO);
+	sc->cookie = malloc(sizeof(*sc->cookie) * sc->nvec, M_DEVBUF,
+	    M_WAITOK | M_ZERO);
+	sc->isrcs = malloc(sizeof(*sc->isrcs) * sc->nvec, M_DEVBUF,
+	    M_WAITOK | M_ZERO);
+
+	name = device_get_nameunit(dev);
+	for (i = 0; i < sc->nvec; i++) {
+		sc->isrcs[i].vec = i;
+		error = intr_isrc_register(&sc->isrcs[i].isrc, dev, 0,
+		    "%s,%u", name, i);
+		if (error != 0) {
+			device_printf(dev, "cannot register isrc %d\n", i);
+			return (error);
+		}
+		/* Start masked; enable_intr turns them on as they are used. */
+		RP1_WR4(sc, MSIX_CFG_CLR(i), MSIX_CFG_ENABLE);
+	}
+
+	xref = OF_xref_from_node(node);
+	OF_device_register_xref(xref, dev);
+	error = intr_pic_register(dev, xref);
+	if (error != 0) {
+		device_printf(dev, "cannot register as a PIC\n");
+		return (error);
+	}
+
+	for (i = 0; i < sc->nvec; i++) {
+		rid = i + 1;
+		sc->irq_res[i] = bus_alloc_resource_any(dev, SYS_RES_IRQ,
+		    &rid, RF_ACTIVE);
+		if (sc->irq_res[i] == NULL) {
+			device_printf(dev, "cannot allocate MSI-X %d\n", i);
+			return (ENXIO);
+		}
+		error = bus_setup_intr(dev, sc->irq_res[i],
+		    INTR_TYPE_MISC | INTR_MPSAFE, rp1_intr, NULL,
+		    &sc->isrcs[i], &sc->cookie[i]);
+		if (error != 0) {
+			device_printf(dev, "cannot hook MSI-X %d\n", i);
+			return (error);
+		}
+	}
+
+	if (bootverbose)
+		device_printf(dev, "%d MSI-X vectors as interrupt sources\n",
+		    sc->nvec);
+
+	return (0);
+}
+
 static int
 rp1_probe(device_t dev)
 {
@@ -132,6 +337,15 @@ rp1_attach(device_t dev)
 		    (uintmax_t)rman_get_start(sc->bar),
 		    (uintmax_t)rman_get_size(sc->bar));
 
+	/*
+	 * Stand up the interrupt controller before adding children: their
+	 * resource lists are built from DT interrupts, which cannot be
+	 * mapped until this node is a registered PIC.
+	 */
+	error = rp1_setup_intr_controller(dev, node);
+	if (error != 0)
+		goto fail;
+
 	/* Become an FDT bus for the peripherals behind the BAR. */
 	simplebus_init(dev, node);
 	if (simplebus_fill_ranges(node, &sc->base) < 0) {
@@ -155,6 +369,14 @@ static device_method_t rp1_methods[] = {
 	DEVMETHOD(device_probe,		rp1_probe),
 	DEVMETHOD(device_attach,	rp1_attach),
 
+	/* RP1 is an interrupt controller for everything behind it. */
+	DEVMETHOD(pic_map_intr,		rp1_map_intr),
+	DEVMETHOD(pic_enable_intr,	rp1_enable_intr),
+	DEVMETHOD(pic_disable_intr,	rp1_disable_intr),
+	DEVMETHOD(pic_pre_ithread,	rp1_pre_ithread),
+	DEVMETHOD(pic_post_ithread,	rp1_post_ithread),
+	DEVMETHOD(pic_post_filter,	rp1_post_filter),
+
 	DEVMETHOD_END
 };
 
